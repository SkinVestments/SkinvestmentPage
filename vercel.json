{
  "redirects": [
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/cs2-skin-tracker/",
      "destination": "/cs2-skin-tracker",
      "permanent": true
    },
    {
      "source": "/skinprofit-alternative",
      "destination": "/cs2-skin-tracker",
      "permanent": true
    },
    {
      "source": "/skinprofit-alternative/",
      "destination": "/cs2-skin-tracker",
      "permanent": true
    },
    {
      "source": "/vs/skinprofit",
      "destination": "/cs2-skin-tracker",
      "permanent": true
    },
    {
      "source": "/vs/skinprofit/",
      "destination": "/cs2-skin-tracker",
      "permanent": true
    },
    {
      "source": "/skinshunter-alternative",
      "destination": "/cs2-skin-tracker",
      "permanent": true
    },
    {
      "source": "/skinshunter-alternative/",
      "destination": "/cs2-skin-tracker",
      "permanent": true
    },
    {
      "source": "/p/:token/",
      "destination": "/p/:token",
      "permanent": true
    },
    {
      "source": "/embed/:token/",
      "destination": "/embed/:token",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog/:slug/",
      "destination": "/blog/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/p/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|slurp|facebookexternalhit|facebot|discordbot|twitterbot|linkedinbot|slackbot|embedly|quora link preview|pinterest|redditbot|whatsapp|telegrambot|vkshare|w3c_validator).*"
        }
      ],
      "destination": "/api/share-og?token=:token"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/:path*/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ]
}
